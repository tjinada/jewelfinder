# =============================================================================
# The Clasp — Admin Analytics environment
# =============================================================================
# These are only needed if you run the admin app directly (node server.mjs).
# When run via docker-compose.admin.yml the values are set there instead.

# Mongo connection. "jewel-mongo" is the container_name from the main
# docker-compose.yml; it resolves on the shared "jewel" docker network.
# (The service alias "mongo" works too.)
MONGO_URI=mongodb://jewel-mongo:27017/jewel-finder

# Port the server listens on inside the container.
PORT=3000
