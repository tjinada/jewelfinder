# =============================================================================
# Jewel Finder - Environment Example
# =============================================================================
# Copy this file to .env and fill in your values. Do NOT commit .env.
# =============================================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/jewel-finder

# JWT (auth) - generate a strong secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Uploaded jewelry images are stored here and served from /api/media
MEDIA_DIR=./media

# Push Notifications (VAPID) - generate with:  npx web-push generate-vapid-keys
# VAPID_EMAIL must start with "mailto:"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# Google sign-in (optional). Create an OAuth "Web application" client in Google
# Cloud Console and paste its Client ID here. Leave blank to disable Google
# sign-in (the button simply won't appear).
GOOGLE_CLIENT_ID=

# Frontend origin (for CORS in development)
FRONTEND_URL=http://localhost:5173
