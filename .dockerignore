# =============================================================================
# Docker Ignore - Jewel Finder
# =============================================================================

# Dependencies (installed fresh in container)
node_modules
**/node_modules

# Build outputs (built in container)
dist
**/dist
dev-dist
**/dev-dist

# Env
.env
.env.local
.env.*.local

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Uploaded media (the runtime uploads dirs only — NOT the source module
# at packages/backend/src/modules/media). Leading slash anchors to repo root.
/media
/packages/backend/media

# Testing
coverage
.nyc_output

# Documentation (not needed in container)
docs
*.md
!README.md

# OS
.DS_Store
Thumbs.db

# Misc
.eslintcache
.turbo
